{
	"name": "@crustjs/progress",
	"version": "0.1.2",
	"description": "Progress indicators for the Crust CLI ecosystem",
	"type": "module",
	"sideEffects": false,
	"license": "MIT",
	"author": "chenxin-yan",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/chenxin-yan/crust.git",
		"directory": "packages/progress"
	},
	"homepage": "https://crustjs.com",
	"bugs": {
		"url": "https://github.com/chenxin-yan/crust/issues"
	},
	"keywords": [
		"cli",
		"progress",
		"spinner",
		"terminal",
		"bun",
		"typescript"
	],
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "vp pack",
		"dev": "vp pack --watch",
		"check:types": "tsc --noEmit",
		"test": "vp test",
		"prepack": "cp ../../LICENSE LICENSE",
		"postpack": "rm -f LICENSE"
	},
	"dependencies": {
		"@crustjs/style": "workspace:^",
		"@crustjs/utils": "workspace:^"
	},
	"peerDependencies": {
		"typescript": "^7.0.0"
	},
	"peerDependenciesMeta": {
		"typescript": {
			"optional": true
		}
	},
	"devDependencies": {
		"@crustjs/config": "workspace:*",
		"vite-plus": "catalog:"
	},
	"engines": {
		"bun": ">=1.4.0",
		"node": ">=22",
		"deno": ">=2.8"
	}
}
