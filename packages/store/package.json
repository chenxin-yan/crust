{
	"name": "@crustjs/store",
	"version": "0.2.0",
	"description": "DX-first, typed persistence for CLI apps with config/data/state/cache separation",
	"type": "module",
	"license": "MIT",
	"author": "chenxin-yan",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/chenxin-yan/crust.git",
		"directory": "packages/store"
	},
	"homepage": "https://crustjs.com",
	"bugs": {
		"url": "https://github.com/chenxin-yan/crust/issues"
	},
	"keywords": [
		"cli",
		"config",
		"data",
		"state",
		"cache",
		"store",
		"persistence",
		"xdg",
		"bun",
		"typescript"
	],
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "bunup",
		"dev": "bunup --watch",
		"check:types": "tsc --noEmit",
		"test": "bun test",
		"publish": "bun publish --no-git-checks || true"
	},
	"devDependencies": {
		"@crustjs/config": "workspace:*",
		"bunup": "catalog:",
		"effect": "3.21.2",
		"zod": "^4.0.0"
	},
	"peerDependencies": {
		"typescript": "catalog:"
	},
	"dependencies": {
		"@crustjs/utils": "workspace:*",
		"@standard-schema/spec": "^1.1.0"
	}
}
