{
	"name": "@crustjs/store",
	"version": "0.2.0",
	"description": "DX-first, typed persistence for CLI apps with config/data/state/cache separation",
	"type": "module",
	"sideEffects": false,
	"license": "MIT",
	"author": "chenxin-yan",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/chenxin-yan/crust.git",
		"directory": "packages/store"
	},
	"homepage": "https://crustjs.com",
	"bugs": {
		"url": "https://github.com/chenxin-yan/crust/issues"
	},
	"keywords": [
		"cli",
		"config",
		"data",
		"state",
		"cache",
		"store",
		"persistence",
		"xdg",
		"bun",
		"typescript"
	],
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"check:types": "tsc --noEmit",
		"test": "bun test",
		"publish": "bun publish --no-git-checks",
		"prepack": "cp ../../LICENSE LICENSE",
		"postpack": "rm -f LICENSE"
	},
	"devDependencies": {
		"@crustjs/config": "workspace:*",
		"zod": "^4.0.0",
		"@crustjs/utils": "workspace:*",
		"tsdown": "catalog:"
	},
	"peerDependencies": {
		"typescript": "^7.0.0"
	},
	"peerDependenciesMeta": {
		"typescript": {
			"optional": true
		}
	},
	"engines": {
		"bun": ">=1.3.14",
		"node": ">=20"
	}
}
