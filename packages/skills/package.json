{
	"name": "@crustjs/skills",
	"version": "0.1.2",
	"description": "Agent skill generation from Crust command definitions",
	"type": "module",
	"license": "MIT",
	"author": "chenxin-yan",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/chenxin-yan/crust.git",
		"directory": "packages/skills"
	},
	"homepage": "https://crustjs.com",
	"bugs": {
		"url": "https://github.com/chenxin-yan/crust/issues"
	},
	"keywords": [
		"cli",
		"skills",
		"agent",
		"generation",
		"documentation",
		"bun",
		"typescript"
	],
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./agents": {
			"types": "./dist/agents.d.ts",
			"import": "./dist/agents.js"
		},
		"./annotations": {
			"types": "./dist/annotations.d.ts",
			"import": "./dist/annotations.js"
		},
		"./bundle": {
			"types": "./dist/bundle.d.ts",
			"import": "./dist/bundle.js"
		},
		"./extension": {
			"types": "./dist/extension.d.ts",
			"import": "./dist/extension.js"
		},
		"./generate": {
			"types": "./dist/generate.d.ts",
			"import": "./dist/generate.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "bunup",
		"dev": "bunup --watch",
		"check:types": "tsc --noEmit",
		"test": "bun test",
		"publish": "bun publish --no-git-checks",
		"prepack": "cp ../../LICENSE LICENSE",
		"postpack": "rm -f LICENSE"
	},
	"dependencies": {
		"@crustjs/progress": "workspace:^",
		"@crustjs/prompts": "workspace:^",
		"@crustjs/style": "workspace:^"
	},
	"devDependencies": {
		"@crustjs/config": "workspace:*",
		"@crustjs/core": "workspace:*",
		"@crustjs/utils": "workspace:*",
		"bunup": "catalog:"
	},
	"peerDependencies": {
		"@crustjs/core": "workspace:0.x",
		"typescript": "^7.0.0"
	},
	"peerDependenciesMeta": {
		"typescript": {
			"optional": true
		}
	},
	"engines": {
		"bun": ">=1.3.14"
	}
}
