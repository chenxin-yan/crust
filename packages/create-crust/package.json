{
	"name": "create-crust",
	"version": "0.6.0",
	"description": "Scaffold a new Crust CLI project for Bun or Node.js",
	"type": "module",
	"sideEffects": false,
	"license": "MIT",
	"author": "chenxin-yan",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/chenxin-yan/crust.git",
		"directory": "packages/create-crust"
	},
	"homepage": "https://crustjs.com",
	"bugs": {
		"url": "https://github.com/chenxin-yan/crust/issues"
	},
	"keywords": [
		"cli",
		"scaffold",
		"create",
		"generator",
		"bun",
		"typescript",
		"crust"
	],
	"publishConfig": {
		"access": "public"
	},
	"crust": {
		"runtime": "node",
		"artifact": "package",
		"include": [
			"templates"
		]
	},
	"bin": {
		"create-crust": "src/cli.ts"
	},
	"scripts": {
		"build": "vp run build:task",
		"dev": "pnpm run build && bun src/cli.ts",
		"release": "crust publish",
		"check:types": "vp run check:types:task",
		"test": "vp run test:task"
	},
	"dependencies": {
		"@crustjs/core": "workspace:^",
		"@crustjs/create": "workspace:^",
		"@crustjs/progress": "workspace:^",
		"@crustjs/prompts": "workspace:^",
		"eta": "^4.6.0"
	},
	"devDependencies": {
		"@crustjs/config": "workspace:*",
		"@crustjs/crust": "workspace:*",
		"@crustjs/extensions": "workspace:*",
		"vite-plus": "catalog:"
	},
	"engines": {
		"bun": ">=1.4.0",
		"node": ">=24"
	}
}
