{
	"name": "create-crust",
	"version": "0.0.31",
	"description": "Scaffold a new Crust CLI project.",
	"type": "module",
	"sideEffects": false,
	"license": "MIT",
	"author": "chenxin-yan",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/chenxin-yan/crust.git",
		"directory": "packages/create-crust"
	},
	"homepage": "https://crustjs.com",
	"bugs": {
		"url": "https://github.com/chenxin-yan/crust/issues"
	},
	"keywords": [
		"cli",
		"scaffold",
		"create",
		"generator",
		"bun",
		"typescript",
		"crust"
	],
	"files": [
		"dist",
		"templates"
	],
	"publishConfig": {
		"access": "public"
	},
	"bin": {
		"create-crust": "dist/index.js"
	},
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"check:types": "tsc --noEmit",
		"test": "bun test",
		"test:smoke": "bun test tests/cli.smoke.test.ts",
		"publish": "bun publish --no-git-checks",
		"prepack": "cp ../../LICENSE LICENSE",
		"postpack": "rm -f LICENSE"
	},
	"dependencies": {
		"@crustjs/core": "workspace:^",
		"@crustjs/create": "workspace:^",
		"@crustjs/progress": "workspace:^",
		"@crustjs/prompts": "workspace:^"
	},
	"devDependencies": {
		"@crustjs/config": "workspace:*",
		"tsdown": "catalog:"
	},
	"engines": {
		"bun": ">=1.3.14",
		"node": ">=22",
		"deno": ">=2.8"
	}
}
