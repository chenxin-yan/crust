{
	"name": "create-crust",
	"version": "0.4.1",
	"description": "Scaffold a new Crust CLI project.",
	"type": "module",
	"sideEffects": false,
	"license": "MIT",
	"author": "chenxin-yan",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/chenxin-yan/crust.git",
		"directory": "packages/create-crust"
	},
	"homepage": "https://crustjs.com",
	"bugs": {
		"url": "https://github.com/chenxin-yan/crust/issues"
	},
	"keywords": [
		"cli",
		"scaffold",
		"create",
		"generator",
		"bun",
		"typescript",
		"crust"
	],
	"publishConfig": {
		"access": "public"
	},
	"crust": {
		"runtime": "node",
		"include": [
			"templates"
		]
	},
	"bin": {
		"create-crust": "src/index.ts"
	},
	"scripts": {
		"build": "vp run build:task",
		"dev": "pnpm run build && bun src/index.ts",
		"release": "crust publish",
		"check:types": "vp run check:types:task",
		"test": "vp run test:task",
		"test:smoke": "vp test tests/cli.smoke.test.ts"
	},
	"dependencies": {
		"@crustjs/core": "workspace:^",
		"@crustjs/create": "workspace:^",
		"@crustjs/progress": "workspace:^",
		"@crustjs/prompts": "workspace:^"
	},
	"devDependencies": {
		"@crustjs/config": "workspace:*",
		"@crustjs/crust": "workspace:*",
		"@crustjs/extensions": "workspace:*",
		"vite-plus": "catalog:"
	},
	"engines": {
		"bun": ">=1.4.0",
		"node": ">=22",
		"deno": ">=2.8"
	}
}
