{
	"name": "@crustjs/prompts",
	"version": "0.2.0",
	"description": "Interactive terminal prompts for the Crust CLI ecosystem",
	"type": "module",
	"license": "MIT",
	"author": "chenxin-yan",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/chenxin-yan/crust.git",
		"directory": "packages/prompts"
	},
	"homepage": "https://crustjs.com",
	"bugs": {
		"url": "https://github.com/chenxin-yan/crust/issues"
	},
	"keywords": [
		"cli",
		"prompts",
		"interactive",
		"terminal",
		"bun",
		"typescript"
	],
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./testing": {
			"types": "./dist/testing.d.ts",
			"import": "./dist/testing.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "bunup",
		"dev": "bunup --watch",
		"check:types": "tsc --noEmit",
		"test": "bun test",
		"publish": "bun publish --no-git-checks",
		"prepack": "cp ../../LICENSE LICENSE",
		"postpack": "rm -f LICENSE"
	},
	"dependencies": {
		"@crustjs/style": "workspace:^"
	},
	"devDependencies": {
		"@crustjs/config": "workspace:*",
		"@crustjs/utils": "workspace:*",
		"bunup": "catalog:",
		"zod": "^4.0.0"
	},
	"engines": {
		"bun": ">=1.3.14"
	}
}
