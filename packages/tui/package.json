{
	"name": "@crustjs/tui",
	"version": "0.0.1",
	"description": "OpenTUI adapter for Crust commands",
	"type": "module",
	"sideEffects": false,
	"license": "MIT",
	"author": "chenxin-yan",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/chenxin-yan/crust.git",
		"directory": "packages/tui"
	},
	"homepage": "https://crustjs.com",
	"bugs": {
		"url": "https://github.com/chenxin-yan/crust/issues"
	},
	"keywords": [
		"cli",
		"tui",
		"opentui",
		"terminal",
		"bun",
		"typescript"
	],
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"check:types": "tsc --noEmit",
		"test": "bun test",
		"publish": "bun publish --no-git-checks",
		"prepack": "cp ../../LICENSE LICENSE",
		"postpack": "rm -f LICENSE"
	},
	"peerDependencies": {
		"@opentui/core": "^0.5.11",
		"typescript": "^7.0.0"
	},
	"peerDependenciesMeta": {
		"typescript": {
			"optional": true
		}
	},
	"devDependencies": {
		"@crustjs/config": "workspace:*",
		"@opentui/core": "^0.5.11",
		"tsdown": "catalog:"
	},
	"engines": {
		"bun": ">=1.3.14"
	}
}
