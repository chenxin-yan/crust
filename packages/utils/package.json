{
	"name": "@crustjs/utils",
	"version": "0.1.0",
	"description": "Internal shared utilities for Crust packages",
	"type": "module",
	"sideEffects": false,
	"license": "MIT",
	"author": "chenxin-yan",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/chenxin-yan/crust.git",
		"directory": "packages/utils"
	},
	"homepage": "https://crustjs.com",
	"bugs": {
		"url": "https://github.com/chenxin-yan/crust/issues"
	},
	"files": [
		"dist"
	],
	"exports": {
		"./artifacts": {
			"types": "./dist/artifacts.d.ts",
			"import": "./dist/artifacts.js"
		},
		"./error": {
			"types": "./dist/error.d.ts",
			"import": "./dist/error.js"
		},
		"./json": {
			"types": "./dist/json.d.ts",
			"import": "./dist/json.js"
		},
		"./path": {
			"types": "./dist/path.d.ts",
			"import": "./dist/path.js"
		},
		"./primitive": {
			"types": "./dist/primitive.d.ts",
			"import": "./dist/primitive.js"
		},
		"./process": {
			"types": "./dist/process.d.ts",
			"import": "./dist/process.js"
		},
		"./source": {
			"types": "./dist/source.d.ts",
			"import": "./dist/source.js"
		},
		"./schema": {
			"types": "./dist/schema.d.ts",
			"import": "./dist/schema.js"
		},
		"./terminal": {
			"types": "./dist/terminal.d.ts",
			"import": "./dist/terminal.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "vp pack",
		"dev": "vp pack --watch",
		"check:types": "tsc --noEmit",
		"test": "vp test",
		"prepack": "cp ../../LICENSE LICENSE",
		"postpack": "rm -f LICENSE"
	},
	"devDependencies": {
		"@crustjs/config": "workspace:*",
		"vite-plus": "catalog:"
	},
	"engines": {
		"bun": ">=1.4.0",
		"node": ">=22",
		"deno": ">=2.8"
	}
}
