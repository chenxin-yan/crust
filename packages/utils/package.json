{
	"name": "@crustjs/utils",
	"version": "0.0.1",
	"description": "Shared low-level utilities for the Crust ecosystem (pre-stable)",
	"type": "module",
	"license": "MIT",
	"author": "chenxin-yan",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/chenxin-yan/crust.git",
		"directory": "packages/utils"
	},
	"homepage": "https://crustjs.com",
	"bugs": {
		"url": "https://github.com/chenxin-yan/crust/issues"
	},
	"keywords": [
		"crust",
		"utils",
		"utilities",
		"resolve",
		"package-root",
		"bun",
		"typescript"
	],
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "bunup",
		"dev": "bunup --watch",
		"check:types": "tsc --noEmit",
		"test": "bun test",
		"publish": "bun publish --no-git-checks || true"
	},
	"devDependencies": {
		"@crustjs/config": "workspace:*",
		"bunup": "catalog:"
	},
	"peerDependencies": {
		"typescript": "catalog:"
	}
}
