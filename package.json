{
	"name": "crust",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "turbo run build",
		"build:docs": "turbo run build --filter='./apps/docs'",
		"build:pkgs": "turbo run build --filter='./packages/*'",
		"dev:docs": "turbo run dev --filter='./apps/docs'",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt --check",
		"format:fix": "oxfmt",
		"check": "turbo run build --filter='./packages/*' && bun scripts/check-dist-inlined-utils.mjs && turbo run //#lint //#format",
		"check:fix": "turbo run build --filter='./packages/*' && oxlint --fix && oxfmt",
		"check:types": "turbo run check:types",
		"test": "turbo run test --filter='./packages/*'",
		"changeset": "changeset",
		"packages:version": "changeset version && bun install",
		"packages:publish": "bun ./scripts/publish-packages.mjs"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^0.7.0",
		"@changesets/cli": "^2.31.1",
		"@types/bun": "^1.3.14",
		"oxfmt": "^0.62.0",
		"publint": "^0.3.23",
		"oxlint": "^1.77.0",
		"oxlint-tsgolint": "^7.0.2001",
		"tsdown": "catalog:",
		"turbo": "^2.10.8",
		"typescript": "catalog:"
	},
	"catalog": {
		"typescript": "^7.0.2",
		"tsdown": "^0.22.14"
	},
	"packageManager": "bun@1.3.14",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"overrides": {
		"@types/node": "^24"
	}
}
