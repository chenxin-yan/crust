{
	"name": "crust",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "vp run -r build:task",
		"build:docs": "vp run --filter ./apps/docs build:task",
		"build:pkgs": "vp run --filter './packages/*' build:task",
		"dev:docs": "vp run --filter ./apps/docs dev:task",
		"lint": "vp lint",
		"lint:fix": "vp lint --fix",
		"format": "vp fmt --check",
		"format:fix": "vp fmt",
		"check": "vp run --filter './packages/*' build:task && vp run check:task",
		"check:fix": "vp run --filter './packages/*' build:task && vp check --fix",
		"check:types": "vp run -r check:types:task",
		"test": "vp run --filter './packages/*' --filter ./tools --filter ./scripts test:task",
		"changeset": "changeset",
		"packages:version": "changeset version && pnpm install --lockfile-only --ignore-scripts",
		"packages:pack": "bun ./scripts/publish-packages.mjs --pack-dir",
		"packages:publish": "bun ./scripts/publish-packages.mjs --publish-dir"
	},
	"devDependencies": {
		"@arethetypeswrong/core": "^0.18.5",
		"@changesets/changelog-github": "^1.0.1",
		"@changesets/cli": "^3.0.2",
		"@types/bun": "^1.4.1",
		"publint": "^0.3.24",
		"typescript": "^7.0.2",
		"vite-plus": "catalog:"
	},
	"packageManager": "pnpm@12.6.0"
}
