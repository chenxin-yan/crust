{
	"name": "crust",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"build:docs": "turbo run build --filter='./apps/docs'",
		"build:packages": "turbo run build --filter='./packages/*'",
		"dev:docs": "turbo run dev --filter='./apps/docs'",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt --check",
		"format:fix": "oxfmt",
		"check": "turbo run //#lint //#format",
		"check:fix": "turbo run //#lint:fix //#format:fix",
		"check:types": "turbo run check:types",
		"test": "turbo run test",
		"changeset": "changeset",
		"packages:version": "changeset version && bun install",
		"packages:publish": "bun ./scripts/publish-packages.mjs"
	},
	"devDependencies": {
		"@changesets/cli": "^2.31.0",
		"@types/bun": "^1.3.14",
		"oxfmt": "^0.53.0",
		"oxlint": "^1.68.0",
		"typescript": "catalog:",
		"oxlint-tsgolint": "^7.0.2001",
		"turbo": "^2.9.16"
	},
	"catalog": {
		"bunup": "^0.16.31",
		"typescript": "^7.0.2"
	},
	"packageManager": "bun@1.3.14",
	"workspaces": [
		"apps/*",
		"packages/*"
	]
}
