{
	"name": "crust",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "turbo run build",
		"build:docs": "turbo run build --filter='./apps/docs'",
		"build:pkgs": "turbo run build --filter='./packages/*'",
		"dev:docs": "turbo run dev --filter='./apps/docs'",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt --check",
		"format:fix": "oxfmt",
		"check": "turbo run build --filter='./packages/*' && turbo run //#lint //#format",
		"check:fix": "turbo run build --filter='./packages/*' && oxlint --fix && oxfmt",
		"check:types": "turbo run check:types",
		"test": "turbo run test --filter='./packages/*' --filter='./tools' --filter='./scripts'",
		"changeset": "changeset",
		"packages:version": "changeset version && bun install --lockfile-only --ignore-scripts",
		"packages:pack": "bun ./scripts/publish-packages.mjs --pack-dir",
		"packages:publish": "bun ./scripts/publish-packages.mjs --publish-dir"
	},
	"devDependencies": {
		"@arethetypeswrong/core": "^0.18.5",
		"@changesets/changelog-github": "^1.0.1",
		"@changesets/cli": "^3.0.2",
		"@types/bun": "^1.4.1",
		"oxfmt": "^0.66.0",
		"oxlint": "^1.81.0",
		"oxlint-tsgolint": "^7.0.2001",
		"publint": "^0.3.24",
		"tsdown": "^0.23.0",
		"turbo": "^2.10.12",
		"typescript": "^7.0.2"
	},
	"catalog": {
		"tsdown": "^0.23.0"
	},
	"packageManager": "bun@1.4.2",
	"workspaces": [
		"apps/*",
		"packages/*",
		"scripts",
		"tools"
	],
	"overrides": {
		"@types/node": "^24"
	}
}
