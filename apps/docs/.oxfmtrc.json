{
  "$schema": "../../node_modules/oxfmt/configuration_schema.json",
  "useTabs": true,
  "sortImports": true,
  "sortPackageJson": false,
  "ignorePatterns": [".source/", "src/routeTree.gen.ts"],
  "overrides": [
    {
      "files": ["examples/landing/**"],
      "options": {
        "printWidth": 60
      }
    },
    {
      "files": ["**/*.{md,mdx,json,jsonc,yml,yaml}"],
      "options": {
        "useTabs": false,
        "tabWidth": 2
      }
    }
  ]
}
