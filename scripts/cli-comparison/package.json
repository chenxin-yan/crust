		"cleye": "2.7.0",
		"clipanion": "3.2.1",
		"cmd-ts": "0.15.0",
		"commander": "15.0.0",
		"gunshi": "0.37.3",
		"minimist": "1.2.8",
		"mri": "1.2.0",
		"sade": "1.8.1",
		"yargs": "18.1.0",
		"yargs-parser": "22.0.0"
	},
	"devDependencies": {
		"@types/bun": "1.4.2",
		"@types/minimist": "1.2.5",
		"@types/node": "26.6.2",
		"@types/yargs": "17.0.35",
