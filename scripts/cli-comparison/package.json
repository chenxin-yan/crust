		"smoke": "bun measure.ts --quick",
		"measure": "bun measure.ts",
		"report": "bun report.ts"
	},
	"dependencies": {
		"@stricli/core": "1.3.0",
		"arg": "5.0.2",
		"argparse": "3.0.2",
