{
	"name": "crust-cli-comparison",
	"private": true,
	"type": "module",
	"scripts": {
		"prepare:local": "bun prepare.ts",
		"test": "bun test contract.test.ts",
		"check": "tsc --noEmit && ../../node_modules/.bin/oxlint --config .oxlintrc.json . && ../../node_modules/.bin/oxfmt --check .",
		"build": "bun build.ts",
