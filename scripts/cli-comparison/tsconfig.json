{
	"compilerOptions": {
		"target": "ES2023",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"types": ["bun"]
	},
	"include": ["*.ts", "adapters/*.ts", "probes/*.ts"],
	"exclude": ["node_modules", ".generated", "results"]
}
