{
	"$schema": "https://turborepo.dev/schema.json",
	"ui": "tui",
	"globalDependencies": [
		"mise.toml",
		"packages/config/tsconfig.base.json",
		"tsdown.config.ts",
		"packages/*/tsdown.config.ts"
	],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"env": ["CI"],
			"outputs": ["dist/**", ".crust/**"]
		},
		"//#lint": {},
		"//#format": {},
		"test": {
			"dependsOn": ["build", "^build"]
		},
		"check:types": {
			"dependsOn": ["^build"]
		},
		"dev": {
			"dependsOn": ["^build"],
			"cache": false,
			"persistent": true
		}
	}
}
