{
	"$schema": "https://turborepo.dev/schema.json",
	"ui": "tui",
	"globalDependencies": ["mise.toml", "packages/config/tsconfig.base.json"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			// shared tsdown config lives at the repo root, outside package inputs
			"inputs": ["$TURBO_DEFAULT$", "../../tsdown.config.ts"],
			"env": ["CI"],
			"outputs": ["dist/**", ".crust/**"]
		},
		"//#lint": {},
		"//#format": {},
		"test": {
			"dependsOn": ["build", "^build"]
		},
		"check:types": {
			"dependsOn": ["^build"]
		},
		"dev": {
			"dependsOn": ["^build"],
			"cache": false,
			"persistent": true
		}
	}
}
