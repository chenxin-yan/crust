{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"sortImports": true,
	"sortPackageJson": false,
	"ignorePatterns": [
		".changeset/",
		"**/CHANGELOG.md",
		".pi/",
		"**/tests/fixtures/",
		".worktrees/",
		"apps/docs/.source/",
		"apps/docs/src/routeTree.gen.ts",
		"packages/create-crust/templates/base/tsconfig.json"
	],
	"overrides": [
		{
			"files": ["apps/docs/**"],
			"options": {
				"useTabs": false,
				"tabWidth": 2
			}
		}
	]
}
